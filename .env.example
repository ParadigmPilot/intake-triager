# ─────────────────────────────────────────────────────────────────────────────
# intake-triager environment contract
#
# SECRET = set in Render dashboard, encrypted; do NOT commit a real value here.
# CONFIG = plaintext, may be set in render.yaml or dashboard. Safe to default.
# ─────────────────────────────────────────────────────────────────────────────

# Environment — CONFIG. Set to "production" on Render; "development" for local.
# Gates production static-serving in src/backend/app.js.
NODE_ENV=development

# Anthropic API key — SECRET. Render dashboard only. Render's `sync: false` field.
ANTHROPIC_API_KEY=

# Database connection — SECRET. On Render, auto-populated from linked Postgres
# service via render.yaml `fromDatabase` block. Local dev: plain postgres URL.
DATABASE_URL=postgres://user:pass@localhost:5432/intake_triager

# Model identifier — CONFIG.
MODEL=claude-sonnet-4-20250514

# Server port — CONFIG. Render injects PORT at runtime; leave at 3000 for local.
PORT=3000

# Rate limiting (per-IP requests per minute on /converse) — CONFIG.
RATE_LIMIT_PER_IP_PER_MINUTE=20

# Cost ceiling (cumulative output_tokens per conversation) — CONFIG.
CONVERSATION_TOKEN_CEILING=200000

# CORS allowed origins (comma-separated) — CONFIG.
#   Local dev:  http://localhost:5173
#   Production: same-origin once Express serves the built SPA — set to the
#               public host, e.g. https://demo.restaurantpattern.com
#               (pre-DNS-cutover: https://intake-triager.onrender.com or the
#               auto-assigned Render URL).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Prompt placeholders (substituted into system.md at assembly time) — SECRET.
# Boot-time validation in src/backend/server.js exits non-zero if unset.
ORG_NAME=
CRISIS_LINE=

# === Magic-link demo auth (WO-310.9a) ===
# Resend API key for outbound magic-link emails.
RESEND_API_KEY=

# Sender address. Must be a verified domain in Resend.
# Example: demo@restaurantpattern.com
RESEND_FROM_ADDRESS=

# HMAC secret for signing magic-link tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAGIC_LINK_SECRET=

# Public base URL for magic-link callbacks. Default: https://intake-triager.onrender.com
PUBLIC_BASE_URL=

# Owner UUID for demo_links and demo_sessions rows.
# In single-tenant demo deploy, this is a fixed UUID identifying "the demo operator."
# Generate with: node -e "console.log(require('crypto').randomUUID())"
OWNER_ID=

# Per-session turn budget. Default: 10.
DEMO_TURN_BUDGET=10

# Cloudflare Turnstile secret key for backend captcha verification.
# Site key (public) lives in restaurant-pattern-site's env (WO-310.9d).
# Test keys for local dev:
#   Site key (always passes):  1x00000000000000000000AA
#   Secret key (always passes): 1x0000000000000000000000000000000AA
#   Site key (always fails):    2x00000000000000000000AB
#   Secret key (always fails):  2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# === Cost protection (WO-310.9c) ===
# Global daily turn cap across all demo sessions. Default: 100.
# Calibration: $20/month workspace cap ÷ ~$0.095/conversation
# (Sonnet pricing, 10-turn avg) ≈ 70 turns/day. Default 100 leaves
# headroom; tune in production based on Anthropic Usage telemetry.
DEMO_GLOBAL_DAILY_TURN_CAP=100

# Circuit breaker: consecutive transient failures before tripping. Default: 3.
CIRCUIT_BREAKER_TRANSIENT_THRESHOLD=3

# Circuit breaker: open-state duration for transient trips, in ms. Default: 60000 (60s).
CIRCUIT_BREAKER_TRANSIENT_OPEN_MS=60000

# Circuit breaker: open-state duration for workspace-cap trips, in ms.
# Default: 86400000 (24h). Workspace cap resets on the monthly billing
# cycle; this is a coarse upper bound — Anthropic enforces the real cap.
CIRCUIT_BREAKER_WORKSPACE_CAP_OPEN_MS=86400000
